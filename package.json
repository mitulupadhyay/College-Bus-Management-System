{
  "name": "busflow",
  "version": "1.0.0",
  "private": true,
  "description": "BusFlow — College Transportation Management System (frontend prototype: HTML + Tailwind CLI + vanilla JS)",
  "scripts": {
    "dev": "npx @tailwindcss/cli -i ./css/input.css -o ./dist/output.css --watch",
    "build": "npx @tailwindcss/cli -i ./css/input.css -o ./dist/output.css --minify",
    "serve": "npx serve ."
  },
  "keywords": ["tailwindcss", "vanilla-js", "prototype", "college-project", "transportation"],
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3"
  }
}
